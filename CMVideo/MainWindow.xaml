<Window
    Height="600"
    MinHeight="400"
    MinWidth="600"
    Title="CMVideo - Media Library"
    Width="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="CMVideo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:CMVideo"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!--  Menu Bar  -->
        <Menu
            Background="#ffc107"
            Foreground="Black"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">
            <MenuItem Header="Media">
                <MenuItem
                    Click="OpenFolder_Button_Click"
                    Header="Open Folder"
                    x:Name="OpenFolder_Button">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FolderOpen" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="Exit_Click" Header="Exit">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="ExitToApp" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Information" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!--  Main Grid Layout  -->
        <Grid Background="#323232" Margin="0,24,0,0">
            <materialDesign:Card Margin="0">
                <TabControl
                    SnapsToDevicePixels="True"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                    TabStripPlacement="Left"
                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True">
                    <materialDesign:NavigationRailAssist.FloatingContent>
                        <Button
                            Background="#ffc107"
                            Click="OpenFolder_Button_Click"
                            Content="{materialDesign:PackIcon Kind=FolderOpen}"
                            Margin="8"
                            Style="{StaticResource MaterialDesignFloatingActionSecondaryButton}"
                            ToolTip="Open Folder" />
                    </materialDesign:NavigationRailAssist.FloatingContent>

                    <!--  Videos Tab  -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Height="auto" Width="auto">
                                <materialDesign:PackIcon
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="Video"
                                    Width="24" />
                                <TextBlock HorizontalAlignment="Center" Text="Videos" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                Text="Video Library" />

                            <!--  Search Box  -->
                            <TextBox
                                Grid.Row="1"
                                Margin="0,0,0,16"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="SearchBox_TextChanged"
                                materialDesign:HintAssist.Hint="Search videos..."
                                x:Name="SearchBox">
                                <TextBox.InputBindings />
                            </TextBox>

                            <!--  Videos ListView  -->
                            <ListView
                                Grid.Row="2"
                                HorizontalContentAlignment="Stretch"
                                MouseDoubleClick="VideosListView_MouseDoubleClick"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionMode="Single"
                                x:Name="VideosListView">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card
                                            Margin="0,4,0,4"
                                            Padding="12"
                                            materialDesign:ElevationAssist.Elevation="Dp2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon
                                                    Foreground="#ffc107"
                                                    Grid.Column="0"
                                                    Height="32"
                                                    Kind="VideoBox"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center"
                                                    Width="32" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontWeight="Medium"
                                                        Text="{Binding FileName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.7"
                                                        Text="{Binding FileSize}" />
                                                </StackPanel>

                                                <Button
                                                    Click="PlayVideo_Click"
                                                    Grid.Column="2"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Tag="{Binding FilePath}"
                                                    ToolTip="Play Video">
                                                    <materialDesign:PackIcon Foreground="#ffc107" Kind="PlayCircle" />
                                                </Button>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!--  Recent Tab  -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Height="auto" Width="auto">
                                <materialDesign:PackIcon
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="ClockOutline"
                                    Width="24" />
                                <TextBlock HorizontalAlignment="Center" Text="Recent" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                Text="Recently Played" />

                            <TextBlock
                                FontStyle="Italic"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Opacity="0.5"
                                Text="Recently played videos will appear here"
                                VerticalAlignment="Center" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>