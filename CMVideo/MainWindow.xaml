<Window
    Height="450"
    Title="MainWindow"
    Width="800"
    mc:Ignorable="d"
    x:Class="CMVideo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CMVideo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>

        <!--  Standard styles for tab control with left placement  -->
        <Style TargetType="TabControl" x:Key="LeftTabControl">
            <Setter Property="Background" Value="#323232" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>



        <!--  Left navigation tab style  -->
        <Style TargetType="TabItem" x:Key="NavigationTab">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            x:Name="TabBorder">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="TabBorder" Value="#454545" />
                                <Setter Property="BorderThickness" TargetName="TabBorder" Value="0,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="TabBorder" Value="#3F3F3F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Standard cards style to replace MaterialDesign:Card  -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.3"
                        ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Floating Action Button Style  -->
        <Style TargetType="Button" x:Key="FloatingActionButton">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>
    <DockPanel>
        <!--  Add Menu at the top of the window  -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Play">
                <MenuItem Click="ExampleButton_Click" Header="Play Single File" />
                <MenuItem Click="Multiplay_Click" Header="Play Multiple Files" />
            </MenuItem>
        </Menu>

        <!--  Add your existing content here  -->
        <!--  For example:  -->
        <Grid>
            <!--  Menu Bar - Standard WPF Menu  -->
            <Menu
                Background="#ffc107"
                Foreground="Black"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <MenuItem Header="Media">
                    <MenuItem
                        Click="File_Button_Click"
                        Header="Open"
                        x:Name="test" />
                    <Separator />
                    <MenuItem Header="Exit" />
                </MenuItem>
                <MenuItem Header="Playback">
                    <MenuItem Click="ExampleButton_Click" Header="Play" />
                    <MenuItem Header="Pause" />
                    <MenuItem Header="Stop" />
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="About" />
                </MenuItem>

            </Menu>

        </Grid>
    </DockPanel>

</Window>