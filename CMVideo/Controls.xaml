<UserControl
    Height="Auto"
    Width="Auto"
    x:Class="CMVideo.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!--  VideoView takes most of the space here maybe fix IDK  -->
            <RowDefinition Height="Auto" />
            <!--  Control buttons  -->
            <RowDefinition Height="Auto" />
            <!--  Slider  -->
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="1"
            Height="auto"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Width="auto">
            <!--  Timestamp with fixed width to prevent layout shifts  -->
            <Grid Margin="10" Width="80">
                <Button
                    Content="{Binding Timestamp}"
                    HorizontalAlignment="Center"
                    IsEnabled="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    x:Name="Timestamp" />
            </Grid>

            <StackPanel
                Height="auto"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Width="auto">
                <Button
                    Command="{Binding RewindCommand}"
                    Margin="5"
                    x:Name="Rewind10">
                    <materialDesign:PackIcon Kind="Rewind10" Width="15" />
                </Button>


                <Button
                    Command="{Binding StopCommand}"
                    Margin="5"
                    x:Name="StopButton">
                    <materialDesign:PackIcon Kind="Stop">
                        <materialDesign:PackIcon.LayoutTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                <SkewTransform />
                                <RotateTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </materialDesign:PackIcon.LayoutTransform>
                    </materialDesign:PackIcon>
                </Button>

                <Button
                    Command="{Binding PlayPauseCommand}"
                    Margin="5"
                    x:Name="PauseButton">
                    <materialDesign:PackIcon Kind="{Binding PlayPauseIcon}">
                        <materialDesign:PackIcon.LayoutTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                <SkewTransform />
                                <RotateTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </materialDesign:PackIcon.LayoutTransform>
                    </materialDesign:PackIcon>
                </Button>

                <Button
                    Command="{Binding ForwardCommand}"
                    HorizontalAlignment="Left"
                    Margin="5"
                    x:Name="Forward10">
                    <materialDesign:PackIcon Kind="FastForward10" Width="15" />
                </Button>
                <Button
                    Command="{Binding ToggleLoopCommand}"
                    HorizontalAlignment="Right"
                    Margin="5"
                    x:Name="Repeat">
                    <materialDesign:PackIcon Kind="{Binding RepeatIcon}" Width="15" />
                </Button>
                <Slider
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    Maximum="100"
                    Value="{Binding Volume}"
                    VerticalAlignment="Center"
                    Width="100"
                    x:Name="Volume" />
            </StackPanel>
        </StackPanel>

        <Slider
            Cursor="Hand"
            Margin="20"
            Maximum="1"
            Value="{Binding Position, Mode=TwoWay}"
            VerticalAlignment="Bottom"
            x:Name="VideoSlider" />
        <Image
            Height="218"
            HorizontalAlignment="Left"
            Margin="118,22,0,0"
            RenderTransformOrigin="0.494,0.535"
            VerticalAlignment="Top"
            Width="277"
            x:Name="ImageBox" />
    </Grid>
</UserControl>