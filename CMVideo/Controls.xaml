<UserControl
    Height="Auto"
    Width="Auto"
    x:Class="CMVideo.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Define standard WPF resources for UI elements  -->
    <UserControl.Resources>
        <!--  Custom button styles  -->
        <Style TargetType="Button" x:Key="MediaButton">
            <Setter Property="Background" Value="#DDDDDD" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#999999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style TargetType="Button" x:Key="RoundButton">
            <Setter Property="Background" Value="#DDDDDD" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#999999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Vector icon templates  -->
        <ControlTemplate x:Key="RewindIcon">
            <Viewbox Stretch="Uniform">
                <Canvas Height="16" Width="16">
                    <Path Data="M2,4 L8,8 L8,4 L14,8 L8,12 L8,8 L2,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="StopIcon">
            <Viewbox Stretch="Uniform">
                <Canvas Height="16" Width="16">
                    <Rectangle
                        Canvas.Left="3"
                        Canvas.Top="3"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Height="10"
                        Width="10" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="PauseIcon">
            <Viewbox Stretch="Uniform">
                <Canvas Height="16" Width="16">
                    <Rectangle
                        Canvas.Left="3"
                        Canvas.Top="3"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Height="10"
                        Width="4" />
                    <Rectangle
                        Canvas.Left="9"
                        Canvas.Top="3"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Height="10"
                        Width="4" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="PlayIcon">
            <Viewbox Stretch="Uniform">
                <Canvas Height="16" Width="16">
                    <Path Data="M4,3 L12,8 L4,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="ForwardIcon">
            <Viewbox Stretch="Uniform">
                <Canvas Height="16" Width="16">
                    <Path Data="M14,4 L8,8 L8,4 L2,8 L8,12 L8,8 L14,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="RepeatIcon">
            <Viewbox Stretch="Uniform">
                <Canvas Height="16" Width="16">
                    <Path
                        Data="M3,6 L3,9 L6,9 M13,10 L13,7 L10,7 M4,4 C6,2 10,2 12,4 C14,6 14,10 12,12 C10,14 6,14 4,12 C2,10 2,6 4,4 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Video content goes in row 0  -->
        <vlc:VideoView
            Grid.Row="0"
            Loaded="VideoView_Loaded"
            x:Name="VideoView" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Margin="10"
            Orientation="Horizontal">
            <!--  Timestamp with fixed width  -->
            <Grid Margin="10" Width="80">
                <Button
                    Content="00:00"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Style="{StaticResource RoundButton}"
                    VerticalAlignment="Center"
                    x:Name="Timestamp" />
            </Grid>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Click="Rewind10_Click"
                    Margin="5"
                    Style="{StaticResource MediaButton}"
                    x:Name="Rewind10">
                    <Control Template="{StaticResource RewindIcon}" />
                </Button>

                <Button
                    Click="PlayButton_Click"
                    Margin="5"
                    Style="{StaticResource MediaButton}"
                    x:Name="PlayButton">
                    <Control Template="{StaticResource PlayIcon}" />
                </Button>

                <Button
                    Click="StopButton_Click"
                    Margin="5"
                    Style="{StaticResource MediaButton}"
                    x:Name="StopButton">
                    <Control Template="{StaticResource StopIcon}" />
                </Button>

                <Button
                    Click="PauseButton_Click"
                    Margin="5"
                    Style="{StaticResource MediaButton}"
                    x:Name="PauseButton">
                    <Control Template="{StaticResource PauseIcon}" />
                </Button>

                <Button
                    Click="Forward10_Click"
                    Margin="5"
                    Style="{StaticResource MediaButton}"
                    x:Name="Forward10">
                    <Control Template="{StaticResource ForwardIcon}" />
                </Button>

                <Button
                    Click="Repeat_Click"
                    Margin="5"
                    Style="{StaticResource MediaButton}"
                    x:Name="Repeat">
                    <Control Template="{StaticResource RepeatIcon}" />
                </Button>

                <Slider
                    Margin="10"
                    Maximum="100"
                    Minimum="0"
                    Value="80"
                    ValueChanged="Volume_ValueChanged"
                    Width="80"
                    x:Name="Volume" />
            </StackPanel>
        </StackPanel>

        <Slider
            Grid.Row="2"
            Margin="10"
            PreviewMouseDown="VideoSlider_DragStarted"
            PreviewMouseUp="VideoSlider_DragCompleted"
            ValueChanged="VideoSlider_ValueChanged"
            x:Name="VideoSlider" />
    </Grid>
</UserControl>